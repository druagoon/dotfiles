# Disable asking for confirmation when installing or upgrading packages
HOMEBREW_NO_ASK=1

# Disable analytics collection by Homebrew (optional)
# HOMEBREW_NO_ANALYTICS=1

# Keep the default daily metadata refresh
HOMEBREW_AUTO_UPDATE_SECS=86400

# Remove older download cache during cleanup
HOMEBREW_CLEANUP_MAX_AGE_DAYS=30

# Homebrew network settings
HOMEBREW_DOWNLOAD_CONCURRENCY=4
HOMEBREW_CURL_RETRIES=3
