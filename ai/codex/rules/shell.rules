# Prefixes also allow trailing arguments. Do not broadly allow tools with write
# or execution modes, such as find, sed, awk, rg, xargs, or shell interpreters.
# These approvals do not replace the filesystem sandbox.

# File contents, directory listings, metadata, and text searches.
prefix_rule(
    pattern = [
        [
            "basename",
            "cat",
            "cmp",
            "dirname",
            "du",
            "grep",
            "head",
            "hexdump",
            "ls",
            "nl",
            "od",
            "pwd",
            "readlink",
            "realpath",
            "stat",
            "strings",
            "tail",
            "wc",
        ],
    ],
    decision = "allow",
)

# System, hardware, process, storage, and user information.
prefix_rule(
    pattern = [
        [
            "arch",
            "df",
            "groups",
            "id",
            "ps",
            "uname",
            "uptime",
            "who",
            "whoami",
        ],
    ],
    decision = "allow",
)
